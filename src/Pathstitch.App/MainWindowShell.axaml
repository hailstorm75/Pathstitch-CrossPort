<Window
  x:Class="Pathstitch.App.MainWindowShell"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Pathstitch CAD"
  Width="1440"
  Height="900"
  MinWidth="1100"
  MinHeight="700"
  d:DesignHeight="900"
  d:DesignWidth="1440"
  Background="#0D0D10"
  AutomationProperties.AutomationId="app.main-window"
  WindowStartupLocation="CenterScreen"
  WindowState="Maximized"
  mc:Ignorable="d">
  <Grid RowDefinitions="*,Auto">
    <ContentControl
      x:Name="PART_PageContainer"
      AutomationProperties.AutomationId="app.page-host" />

    <Border
      Grid.Row="1"
      AutomationProperties.AutomationId="app.contextual-help-status"
      MinHeight="26"
      Padding="10,4"
      Background="#141418"
      BorderBrush="#1FFFFFFF"
      BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          x:Name="PART_ContextualHelpText"
          AutomationProperties.AutomationId="app.contextual-help-text"
          VerticalAlignment="Center"
          FontSize="11"
          Foreground="#A9A9B4"
          Text="Hover over a control for help." />
        <TextBlock
          x:Name="PART_ContextualHelpShortcut"
          Grid.Column="1"
          Margin="16,0,0,0"
          VerticalAlignment="Center"
          FontSize="10"
          FontWeight="SemiBold"
          Foreground="#6A6A74"
          IsVisible="False"
          Text="F1  Open documentation" />
      </Grid>
    </Border>
  </Grid>
</Window>
