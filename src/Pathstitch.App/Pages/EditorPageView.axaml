<UserControl
  x:Class="Pathstitch.App.Pages.EditorPageView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:Pathstitch.App.Controls"
  xmlns:models="using:Domain.App.Models"
  xmlns:viewModels="using:Domain.App.ViewModels"
  x:DataType="viewModels:EditorPageViewModel"
  d:DesignHeight="900"
  d:DesignWidth="1440"
  Focusable="True"
  mc:Ignorable="d">
  <UserControl.Resources>
    <SolidColorBrush x:Key="BaseBackgroundBrush" Color="#0D0D10" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#141418" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1C1C22" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E4E4EA" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6A6A74" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#3E3E48" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4D7FFF" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#1F2D52" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1FFFFFFF" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.tool-button">
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Button.tool-button:pointerover">
      <Setter Property="Background" Value="#23232A" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>

    <Style Selector="Button.tool-button.active">
      <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="Button.panel-button">
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="Button.panel-button:pointerover">
      <Setter Property="Background" Value="#23232A" />
    </Style>

    <Style Selector="Button.face-row">
      <Setter Property="Background" Value="#11000000" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="Button.face-row:pointerover">
      <Setter Property="Background" Value="#23232A" />
    </Style>

    <Style Selector="Button.face-row.active">
      <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="Button.body-select">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.body-select.active">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="Border.body-card.active">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
    </Style>

    <Style Selector="Button.chip-button">
      <Setter Property="Background" Value="#11000000" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Button.chip-button.active">
      <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{StaticResource BaseBackgroundBrush}" RowDefinitions="Auto,*">
    <Border
      Background="{StaticResource PanelBackgroundBrush}"
      BorderBrush="{StaticResource BorderBrush}"
      BorderThickness="0,0,0,1"
      Padding="18,14">
      <DockPanel LastChildFill="True">
        <StackPanel Spacing="3">
          <TextBlock
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="{StaticResource PrimaryTextBrush}"
            Text="{Binding ProjectTitle}" />
          <TextBlock
            FontSize="11"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="{Binding ProjectSubtitle}" />
        </StackPanel>

        <StackPanel
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Spacing="10"
          VerticalAlignment="Center">
          <Border
            Padding="10,6"
            Background="{StaticResource AccentDimBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="2">
              <TextBlock
                FontSize="9"
                FontWeight="SemiBold"
                Foreground="{StaticResource AccentBrush}"
                Text="3D KERNEL" />
              <TextBlock
                FontSize="11"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="{Binding GeometryKernelDisplayName}" />
            </StackPanel>
          </Border>

          <Border
            Padding="10,6"
            Background="{StaticResource InputBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBlock
              FontSize="11"
              Foreground="{StaticResource SecondaryTextBrush}"
              Text="{Binding StatusText}" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="56,220,*,280">
      <Border
        Grid.Column="0"
        Background="{StaticResource PanelBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="0,0,1,0"
        Padding="10,16">
        <StackPanel Spacing="10">
          <ItemsControl ItemsSource="{Binding SidebarTools}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:EditorSidebarToolItemViewModel">
                <StackPanel Spacing="10">
                  <Border
                    Margin="0,4,0,0"
                    Height="1"
                    Background="{StaticResource BorderBrush}"
                    IsVisible="{Binding StartsSection}" />
                  <Button
                    Width="36"
                    Height="36"
                    Classes="tool-button"
                    Classes.active="{Binding IsActive}"
                    IsEnabled="{Binding IsEnabled}"
                    Tag="{Binding Key}"
                    ToolTip.Tip="{Binding TooltipText}"
                    Click="OnSidebarToolClicked">
                    <Path
                      Width="18"
                      Height="18"
                      Data="{Binding IconPathData}"
                      Fill="{Binding $parent[Button].Foreground}"
                      Stretch="Uniform" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border
        Grid.Column="1"
        Background="{StaticResource PanelBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="0,0,1,0"
        Padding="14">
        <StackPanel Spacing="12">
          <TextBlock
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="SOLID BODIES" />

          <TextBlock
            FontSize="11"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="{Binding ViewportStateText}" />

          <Border
            Padding="10"
            Background="{StaticResource InputBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="4">
              <TextBlock
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="IN-PROCESS 3D KERNEL" />
              <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="{Binding GeometryKernelDisplayName}" />
              <TextBlock
                FontSize="10"
                TextWrapping="Wrap"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="{Binding GeometryKernelRuntimeSummary}" />
              <TextBlock
                FontSize="10"
                TextWrapping="Wrap"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="{Binding GeometryKernelSupportedSourceModelSummary}" />
              <TextBlock
                FontSize="10"
                TextWrapping="Wrap"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{Binding GeometryKernelRequirementSummary}" />
            </StackPanel>
          </Border>

          <Button
            Classes="panel-button"
            Content="{Binding SourceModelActionLabel}"
            Click="OnOpenSourceModelClicked" />
          <TextBlock
            FontSize="10"
            TextWrapping="Wrap"
            Foreground="{StaticResource MutedTextBrush}"
            Text="{Binding SourceModelWorkflowHint}" />
          <TextBlock
            FontSize="10"
            TextWrapping="Wrap"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="{Binding SourceModelAssetStatusSummary}" />
          <TextBlock
            FontSize="10"
            Foreground="{StaticResource MutedTextBrush}"
            Text="{Binding BodyInventorySummary}" />
          <TextBlock
            FontSize="10"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="{Binding VisibleBodyScopeSummary}" />

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Bodies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Body3D">
                  <Border
                    Classes="body-card"
                    Margin="0,0,0,10"
                    Padding="10"
                    Background="{StaticResource InputBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Classes.active="{Binding IsSelected}">
                    <StackPanel Spacing="8">
                      <DockPanel>
                        <Button
                          DockPanel.Dock="Left"
                          Width="22"
                          Height="22"
                          Margin="0,0,8,0"
                          Padding="0"
                          Tag="{Binding BodyIndex}"
                          Click="OnBodyVisibilityClicked">
                          <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{Binding VisibilityLabel}" />
                        </Button>
                        <Button
                          Classes="body-select"
                          Classes.active="{Binding IsSelected}"
                          Tag="{Binding BodyIndex}"
                          Click="OnBodySelectClicked">
                          <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{Binding $parent[Button].Foreground}"
                            Text="{Binding Name}" />
                        </Button>
                        <TextBlock
                          DockPanel.Dock="Right"
                          FontSize="10"
                          Foreground="{StaticResource SecondaryTextBrush}"
                          Text="{Binding Faces.Count}" />
                      </DockPanel>

                      <ItemsControl IsVisible="{Binding Visible}" ItemsSource="{Binding Faces}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:Face3D">
                            <Button
                              Classes="face-row"
                              Classes.active="{Binding IsSelected}"
                              Margin="0,0,0,4"
                              Tag="{Binding FaceKey}"
                              PointerPressed="OnFaceSelectionPressed">
                              <DockPanel>
                                <TextBlock
                                  FontSize="11"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  Text="{Binding FaceIndex}" />
                                <TextBlock
                                  DockPanel.Dock="Right"
                                  FontSize="10"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  Text="{Binding Type}" />
                              </DockPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border
        x:Name="WorkspaceViewportSurface"
        Grid.Column="2"
        Background="{StaticResource BaseBackgroundBrush}"
        DragDrop.AllowDrop="True">
        <Grid>
          <NativeWebView x:Name="ViewportWebView" IsVisible="{Binding IsShowing3DWorkspace}" />
          <controls:DxfPreviewCanvas
            x:Name="GeneratedOutputPreviewCanvas"
            IsVisible="{Binding IsShowingGeneratedOutputWorkspace}"
            Document="{Binding GeneratedOutputPreviewDocument, Mode=TwoWay}"
            ActiveTool="{Binding GeneratedOutputActiveTool, Mode=TwoWay}"
            SelectedPathIds="{Binding GeneratedOutputSelectedPathIds, Mode=TwoWay}"
            Measurements="{Binding GeneratedOutputMeasurements, Mode=TwoWay}"
            SelectedMeasurementId="{Binding GeneratedOutputSelectedMeasurementId, Mode=TwoWay}"
            Zoom="{Binding GeneratedOutputViewportZoom, Mode=TwoWay}"
            OffsetX="{Binding GeneratedOutputViewportOffsetX, Mode=TwoWay}"
            OffsetY="{Binding GeneratedOutputViewportOffsetY, Mode=TwoWay}"
            PolygonSides="{Binding GeneratedOutputPolygonSides, Mode=TwoWay}"
            FrameRequestToken="{Binding GeneratedOutputFrameRequestToken}" />

          <Button
            Name="HomeFrameButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12"
            Padding="0"
            Width="34"
            Height="34"
            Background="#E6141418"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            IsVisible="{Binding CanFrameHome}"
            Click="OnHomeFrameClicked">
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="13"
              Foreground="{StaticResource PrimaryTextBrush}"
              Text="⌂" />
          </Button>

          <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="360"
            Padding="22"
            Background="#DD141418"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            IsVisible="{Binding ShowViewportEmptyState}">
            <StackPanel Spacing="12">
              <TextBlock
                HorizontalAlignment="Center"
                FontSize="26"
                FontWeight="Bold"
                Foreground="{StaticResource MutedTextBrush}"
                Text="3D" />
              <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="{Binding ViewportEmptyStateTitle}" />
              <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="{Binding ViewportEmptyStateDescription}" />
              <Button
                HorizontalAlignment="Center"
                Padding="14,8"
                Background="{StaticResource AccentBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                Foreground="White"
                Click="OnOpenSourceModelClicked">
                Open 3D Model...
              </Button>
              <TextBlock
                HorizontalAlignment="Center"
                FontSize="10"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{Binding ViewportStateText}" />
            </StackPanel>
          </Border>

          <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="12"
            Padding="8"
            Background="#E6141418"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="8">
              <TextBlock
                FontSize="11"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="{Binding WorkspaceSurfaceTitle}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                  Classes="chip-button"
                  Classes.active="{Binding IsShowing3DWorkspace}"
                  Content="3D"
                  Click="OnShow3DWorkspaceClicked" />
                <Button
                  Classes="chip-button"
                  Classes.active="{Binding IsShowingGeneratedOutputWorkspace}"
                  IsEnabled="{Binding HasGeneratedOutputPreview}"
                  Content="2D Workspace"
                  Click="OnShowGeneratedOutputWorkspaceClicked" />
              </StackPanel>
              <TextBlock
                FontSize="10"
                TextWrapping="Wrap"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="{Binding WorkspaceModeHint}" />
              <TextBlock
                FontSize="10"
                TextWrapping="Wrap"
                Foreground="{StaticResource MutedTextBrush}"
                IsVisible="{Binding IsShowingGeneratedOutputWorkspace}"
                Text="{Binding GeneratedOutputViewportSummary}" />
              <StackPanel IsVisible="{Binding IsShowingGeneratedOutputWorkspace}" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputSelectToolActive}"
                    Content="Select"
                    Click="OnGeneratedOutputSelectToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputMoveToolActive}"
                    Content="Move"
                    Click="OnGeneratedOutputMoveToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputPanToolActive}"
                    Content="Pan"
                    Click="OnGeneratedOutputPanToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputMeasureToolActive}"
                    Content="Measure"
                    Click="OnGeneratedOutputMeasureToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputDimensionToolActive}"
                    Content="Dim"
                    Click="OnGeneratedOutputDimensionToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputScaleToolActive}"
                    Content="Scale"
                    Click="OnGeneratedOutputScaleToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputMirrorToolActive}"
                    Content="Mirror"
                    Click="OnGeneratedOutputMirrorToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputOffsetToolActive}"
                    Content="Offset"
                    Click="OnGeneratedOutputOffsetToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputAddThicknessToolActive}"
                    Content="Thick"
                    Click="OnGeneratedOutputAddThicknessToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputCleanupToolActive}"
                    Content="Cleanup"
                    Click="OnGeneratedOutputCleanupToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputPatternToolActive}"
                    Content="Pattern"
                    Click="OnGeneratedOutputPatternToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputPaperFoldingToolActive}"
                    Content="Fold"
                    Click="OnGeneratedOutputPaperFoldingToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputTrimToolActive}"
                    Content="Trim"
                    Click="OnGeneratedOutputTrimToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputFilletToolActive}"
                    Content="Fillet"
                    Click="OnGeneratedOutputFilletToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputChamferToolActive}"
                    Content="Chamfer"
                    Click="OnGeneratedOutputChamferToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputConvertLinesToolActive}"
                    Content="Convert"
                    Click="OnGeneratedOutputConvertLinesToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputLineToolActive}"
                    Content="Line"
                    Click="OnGeneratedOutputLineToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputRectangleToolActive}"
                    Content="Rectangle"
                    Click="OnGeneratedOutputRectangleToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputCircleToolActive}"
                    Content="Circle"
                    Click="OnGeneratedOutputCircleToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputTextToolActive}"
                    Content="Text"
                    Click="OnGeneratedOutputTextToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputPenToolActive}"
                    Content="Pen"
                    Click="OnGeneratedOutputPenToolClicked" />
                  <Button
                    Classes="chip-button"
                    Classes.active="{Binding IsGeneratedOutputPolygonToolActive}"
                    Content="Polygon"
                    Click="OnGeneratedOutputPolygonToolClicked" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputPolygonToolActive}">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding GeneratedOutputPolygonSidesSummary}" />
                  <Button
                    Classes="chip-button"
                    Width="32"
                    Content="-"
                    Click="OnDecreaseGeneratedOutputPolygonSidesClicked" />
                  <Button
                    Classes="chip-button"
                    Width="32"
                    Content="+"
                    Click="OnIncreaseGeneratedOutputPolygonSidesClicked" />
                </StackPanel>
                <TextBlock
                  FontSize="10"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="{Binding GeneratedOutputToolHint}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="12"
            Padding="10"
            Background="#E6141418"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsVisible="{Binding IsShowingGeneratedOutputWorkspace}">
            <StackPanel Spacing="8">
              <TextBlock
                FontSize="11"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="2D Selection" />
              <TextBlock
                FontSize="10"
                TextWrapping="Wrap"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="{Binding GeneratedOutputSelectionSummary}" />
              <TextBlock
                FontSize="10"
                TextWrapping="Wrap"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{Binding GeneratedOutputMeasurementSummary}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                  Classes="chip-button"
                  IsEnabled="{Binding HasGeneratedOutputSelection}"
                  Content="Clear Selection"
                  Click="OnClearGeneratedOutputSelectionClicked" />
                <Button
                  Classes="chip-button"
                  IsEnabled="{Binding CanExpandGeneratedOutputRectangles}"
                  Content="Expand Rectangles"
                  Click="OnExpandGeneratedOutputRectanglesClicked" />
                <Button
                  Classes="chip-button"
                  IsEnabled="{Binding HasGeneratedOutputMeasurements}"
                  Content="Clear Measures"
                  Click="OnClearGeneratedOutputMeasurementsClicked" />
              </StackPanel>
              <StackPanel
                Spacing="8"
                IsVisible="{Binding IsGeneratedOutputOffsetToolActive}">
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Offset" />
                <TextBlock
                  FontSize="10"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="{Binding GeneratedOutputOffsetSummary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Mode" />
                  <ComboBox
                    Width="100"
                    ItemsSource="{Binding GeneratedOutputOffsetModeOptionItems}"
                    SelectedItem="{Binding GeneratedOutputOffsetMode, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputCurveOffsetMode}">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Distance (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputOffsetDistanceText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputCurveOffsetMode}">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Side" />
                  <ComboBox
                    Width="100"
                    ItemsSource="{Binding GeneratedOutputOffsetSideOptionItems}"
                    SelectedItem="{Binding GeneratedOutputOffsetSide, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputBBoxOffsetMode}">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="BBox Distance (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputOffsetBBoxDistanceText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputBBoxOffsetMode}">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Corner Fillet (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputOffsetBBoxFilletText, Mode=TwoWay}" />
                </StackPanel>
                <Button
                  Classes="chip-button"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanApplyGeneratedOutputOffset}"
                  Content="Apply Offset"
                  Click="OnApplyGeneratedOutputOffsetClicked" />
              </StackPanel>
              <StackPanel
                Spacing="8"
                IsVisible="{Binding IsGeneratedOutputAddThicknessToolActive}">
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Add Thickness" />
                <TextBlock
                  FontSize="10"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="{Binding GeneratedOutputAddThicknessSummary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Width (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputAddThicknessWidthText, Mode=TwoWay}" />
                </StackPanel>
                <Button
                  Classes="chip-button"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanApplyGeneratedOutputAddThickness}"
                  Content="Apply Thickness"
                  Click="OnApplyGeneratedOutputAddThicknessClicked" />
              </StackPanel>
              <StackPanel
                Spacing="8"
                IsVisible="{Binding IsGeneratedOutputCleanupToolActive}">
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Join/Cleanup" />
                <TextBlock
                  FontSize="10"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="{Binding GeneratedOutputCleanupSummary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Tolerance (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputCleanupToleranceText, Mode=TwoWay}" />
                </StackPanel>
                <Button
                  Classes="chip-button"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanApplyGeneratedOutputCleanup}"
                  Content="Apply Cleanup"
                  Click="OnApplyGeneratedOutputCleanupClicked" />
              </StackPanel>
              <StackPanel
                Spacing="8"
                IsVisible="{Binding IsGeneratedOutputPatternToolActive}">
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Pattern" />
                <TextBlock
                  FontSize="10"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="{Binding GeneratedOutputPatternSummary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Mode" />
                  <ComboBox
                    Width="120"
                    ItemsSource="{Binding GeneratedOutputPatternModeOptionItems}"
                    SelectedItem="{Binding GeneratedOutputPatternMode, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputRectangularPatternMode}">
                  <TextBlock
                    Width="96"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Count X" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputPatternCopiesXText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputRectangularPatternMode}">
                  <TextBlock
                    Width="96"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Count Y" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputPatternCopiesYText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputRectangularPatternMode}">
                  <TextBlock
                    Width="96"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Spacing X (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputPatternSpacingXText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputRectangularPatternMode}">
                  <TextBlock
                    Width="96"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Spacing Y (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputPatternSpacingYText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputCircularPatternMode}">
                  <TextBlock
                    Width="96"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Count" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputPatternCircularCountText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsGeneratedOutputCircularPatternMode}">
                  <TextBlock
                    Width="96"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Angle (deg)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputPatternCircularAngleText, Mode=TwoWay}" />
                </StackPanel>
                <Button
                  Classes="chip-button"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanApplyGeneratedOutputPattern}"
                  Content="Apply Pattern"
                  Click="OnApplyGeneratedOutputPatternClicked" />
              </StackPanel>
              <StackPanel
                Spacing="8"
                IsVisible="{Binding IsGeneratedOutputPaperFoldingToolActive}">
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Paper Folding" />
                <TextBlock
                  FontSize="10"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="{Binding GeneratedOutputPaperFoldingSummary}" />
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource AccentBrush}"
                  Text="Crease Pattern" />
                <Button
                  Classes="chip-button"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanApplyGeneratedOutputPaperFoldingCreases}"
                  Content="Apply Dashed Creases"
                  Click="OnApplyGeneratedOutputPaperFoldingCreasesClicked" />
                <Border
                  Height="1"
                  Background="{StaticResource BorderBrush}" />
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource AccentBrush}"
                  Text="Glue Tabs" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    Width="108"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Height (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputGlueTabHeightText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    Width="108"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Tab Type" />
                  <ComboBox
                    Width="120"
                    ItemsSource="{Binding GeneratedOutputGlueTabTypeOptionItems}"
                    SelectedItem="{Binding GeneratedOutputGlueTabType, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    Width="108"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Side" />
                  <ComboBox
                    Width="120"
                    ItemsSource="{Binding GeneratedOutputGlueTabSideOptionItems}"
                    SelectedItem="{Binding GeneratedOutputGlueTabSide, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    Width="108"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Start Offset (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputGlueTabStartOffsetText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    Width="108"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="End Offset (mm)" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputGlueTabEndOffsetText, Mode=TwoWay}" />
                </StackPanel>
                <Button
                  Classes="chip-button"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanApplyGeneratedOutputGlueTabs}"
                  Content="Apply Glue Tabs"
                  Click="OnApplyGeneratedOutputGlueTabsClicked" />
              </StackPanel>
              <StackPanel
                Spacing="8"
                IsVisible="{Binding IsGeneratedOutputConvertLinesToolActive}">
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Convert Lines" />
                <TextBlock
                  FontSize="10"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="{Binding GeneratedOutputConvertLineSummary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Style" />
                  <ComboBox
                    Width="140"
                    ItemsSource="{Binding GeneratedOutputConvertLineStyleOptions}"
                    SelectedItem="{Binding GeneratedOutputConvertLineStyle, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding HasGeneratedOutputConvertLineFirstParameter}">
                  <TextBlock
                    Width="128"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding GeneratedOutputConvertLineFirstParameterLabel}" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputConvertLineFirstParameterText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding HasGeneratedOutputConvertLineSecondParameter}">
                  <TextBlock
                    Width="128"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding GeneratedOutputConvertLineSecondParameterLabel}" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputConvertLineSecondParameterText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding HasGeneratedOutputConvertLineThirdParameter}">
                  <TextBlock
                    Width="128"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding GeneratedOutputConvertLineThirdParameterLabel}" />
                  <TextBox
                    Width="88"
                    Text="{Binding GeneratedOutputConvertLineThirdParameterText, Mode=TwoWay}" />
                </StackPanel>
                <Button
                  Classes="chip-button"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanApplyGeneratedOutputConvertLines}"
                  Content="Apply Conversion"
                  Click="OnApplyGeneratedOutputConvertLinesClicked" />
              </StackPanel>
              <StackPanel
                Spacing="8"
                IsVisible="{Binding HasSingleGeneratedOutputTextSelection}">
                <TextBlock
                  FontSize="10"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Selected Text" />
                <TextBox
                  MinWidth="240"
                  MinHeight="68"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  Text="{Binding GeneratedOutputSelectedTextDraft, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Height (mm)" />
                  <TextBox
                    Width="76"
                    Text="{Binding GeneratedOutputSelectedTextHeightText, Mode=TwoWay}" />
                  <Button
                    Classes="chip-button"
                    IsEnabled="{Binding CanApplyGeneratedOutputSelectedText}"
                    Content="Apply Text"
                    Click="OnApplyGeneratedOutputSelectedTextClicked" />
                </StackPanel>
                <TextBlock
                  FontSize="10"
                  Foreground="#FFB85C"
                  IsVisible="{Binding IsGeneratedOutputSelectedTextHeightInvalid}"
                  Text="Enter a valid numeric text height." />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding IsLoading}"
            Padding="14,10"
            Background="#DD141418"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel Spacing="8">
              <ProgressBar IsIndeterminate="True" Width="180" />
              <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="{Binding ViewportStateText}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border
        Grid.Column="3"
        Background="{StaticResource PanelBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1,0,0,0"
        Padding="14">
        <ScrollViewer>
          <StackPanel Spacing="18">
            <StackPanel IsVisible="{Binding ShowSelectionPanel}" Spacing="8">
              <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="SELECTED FACES" />
              <Border
                Padding="10"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SelectedFacesQueueSummary}" />
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding SelectionSummary}" />
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding LastViewportEvent}" />
                    </StackPanel>
                    <Button
                      DockPanel.Dock="Right"
                      Classes="panel-button"
                      IsVisible="{Binding HasFaceSelection}"
                      Content="Clear All"
                      Click="OnClearSelectionClicked" />
                  </DockPanel>

                  <ItemsControl ItemsSource="{Binding SelectedFaceDetails}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:SelectedFaceDetails">
                        <Border
                          Margin="0,4,0,0"
                          Padding="8"
                          Background="#11000000"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="4">
                          <StackPanel Spacing="6">
                            <DockPanel LastChildFill="False">
                              <StackPanel DockPanel.Dock="Left" Spacing="2">
                                <TextBlock
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource AccentBrush}"
                                  Text="{Binding QueueLabel}" />
                                <TextBlock
                                  FontSize="10"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  Text="{Binding BodyName}" />
                              </StackPanel>
                              <Button
                                DockPanel.Dock="Right"
                                Classes="panel-button"
                                MinWidth="0"
                                Padding="8,4"
                                Tag="{Binding SelectionKey}"
                                Content="Remove"
                                Click="OnRemoveSelectedFaceClicked" />
                            </DockPanel>

                            <DockPanel LastChildFill="False">
                              <Border
                                DockPanel.Dock="Left"
                                Padding="6,2"
                                Background="#16000000"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <TextBlock
                                  FontSize="10"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  Text="{Binding FaceType}" />
                              </Border>
                              <TextBlock
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{Binding AreaLabel}" />
                            </DockPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowMeasurePanel}" Spacing="8">
              <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="FACE DISTORTION" />
              <Border
                Padding="10"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                  <TextBlock
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding FaceDistortionInspectorHint}" />

                  <TextBlock
                    FontSize="10"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding FaceDistortionStatusText}" />

                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="8">
                    <TextBlock
                      Grid.Row="0"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      FontSize="10"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      Text="Mode" />
                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding DistortionModeIndex}">
                      <ComboBoxItem Content="Conformal" />
                      <ComboBoxItem Content="Equal-Area" />
                      <ComboBoxItem Content="Equidistant" />
                      <ComboBoxItem Content="Balanced" />
                    </ComboBox>
                  </Grid>

                  <TextBlock
                    FontSize="10"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding DistortionModeLabel}" />

                  <Button
                    Classes="panel-button"
                    IsEnabled="{Binding CanRefreshFaceDistortion}"
                    Content="{Binding FaceDistortionRefreshButtonText}"
                    Click="OnRefreshFaceDistortionClicked" />

                  <TextBlock
                    FontSize="10"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding FaceDistortionModeSummary}" />

                  <Border
                    IsVisible="{Binding HasFaceDistortionSummary}"
                    Padding="8"
                    Background="#11000000"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock
                          FontSize="11"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          Text="{Binding MeasuredFaceTitle}" />
                        <TextBlock
                          FontSize="10"
                          Foreground="{StaticResource SecondaryTextBrush}"
                          Text="{Binding MeasuredFaceSubtitle}" />
                      </StackPanel>

                      <Border
                        Padding="8"
                        Background="#16000000"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Spacing="4">
                          <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="ASSESSMENT" />
                          <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding FaceDistortionSeverityLabel}" />
                          <TextBlock
                            FontSize="10"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding FaceDistortionSurfaceBehaviorSummary}" />
                        </StackPanel>
                      </Border>

                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                          <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Average" />
                          <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding FaceDistortionAverageText}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                          <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Maximum" />
                          <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding FaceDistortionMaximumText}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                          <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Range" />
                          <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding FaceDistortionRangeText}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                          <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Samples" />
                          <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding FaceDistortionSampleCountText}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowMoveBodiesPanel}" Spacing="8">
              <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="MOVE BODIES" />
              <Border
                Padding="10"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                  <ToggleSwitch
                    Content="Move Tool"
                    IsChecked="{Binding IsMoveToolActive}"
                    IsCheckedChanged="OnMoveToolIsCheckedChanged" />
                  <TextBlock
                    FontSize="11"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding SelectedBodySummary}" />
                  <TextBlock
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding SelectedBodyOffsetSummary}" />
                  <TextBlock
                    FontSize="10"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding SelectedBodyOffsetMagnitudeText}" />
                  <TextBlock
                    FontSize="10"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding MoveBodiesHint}" />
                  <TextBlock
                    FontSize="10"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding BodyOffsetsSummary}" />

                  <Border
                    IsVisible="{Binding HasAnyBodyOffsets}"
                    Padding="8"
                    Background="#11000000"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="6">
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="MOVED BODIES" />
                      <ItemsControl ItemsSource="{Binding MovedBodyOffsets}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:MovedBodyOffsetSummary">
                            <Border
                              Margin="0,0,0,6"
                              Padding="8"
                              Background="#16000000"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="4">
                              <StackPanel Spacing="6">
                                <DockPanel LastChildFill="False">
                                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                                    <TextBlock
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource PrimaryTextBrush}"
                                      Text="{Binding BodyName}" />
                                    <TextBlock
                                      FontSize="10"
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      Text="{Binding OffsetSummary}" />
                                    <TextBlock
                                      FontSize="10"
                                      Foreground="{StaticResource MutedTextBrush}"
                                      Text="{Binding DistanceText}" />
                                  </StackPanel>
                                  <TextBlock
                                    DockPanel.Dock="Right"
                                    FontSize="10"
                                    Foreground="{StaticResource AccentBrush}"
                                    IsVisible="{Binding IsSelected}"
                                    Text="Selected" />
                                </DockPanel>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                  <Button
                                    Grid.Column="0"
                                    Classes="panel-button"
                                    Tag="{Binding BodyIndex}"
                                    Content="Select"
                                    Click="OnSelectMovedBodyClicked" />
                                  <Button
                                    Grid.Column="1"
                                    Classes="panel-button"
                                    Tag="{Binding BodyIndex}"
                                    Content="Reset"
                                    Click="OnResetMovedBodyClicked" />
                                </Grid>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                      Grid.Column="0"
                      Classes="panel-button"
                      IsVisible="{Binding HasSelectedBody}"
                      Content="Clear Selected Body"
                      Click="OnClearSelectedBodyClicked" />
                    <Button
                      Grid.Column="1"
                      Classes="panel-button"
                      IsEnabled="{Binding CanResetAllBodyPositions}"
                      Content="Reset All Moved"
                      Click="OnResetAllBodiesClicked" />
                  </Grid>

                  <StackPanel IsVisible="{Binding CanEditSelectedBodyOffset}" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                      <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="X (mm)" />
                      <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        IsEnabled="{Binding CanEditSelectedBodyOffsetValues}"
                        Text="{Binding SelectedBodyOffsetXText}" />

                      <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Y (mm)" />
                      <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        IsEnabled="{Binding CanEditSelectedBodyOffsetValues}"
                        Text="{Binding SelectedBodyOffsetYText}" />

                      <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Z (mm)" />
                      <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        IsEnabled="{Binding CanEditSelectedBodyOffsetValues}"
                        Text="{Binding SelectedBodyOffsetZText}" />

                      <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Step" />
                      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BodyMoveStepText}" />
                    </Grid>

                    <TextBlock
                      FontSize="10"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="{Binding SelectedBodyOffsetInputHint}" />

                    <TextBlock
                      FontSize="10"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="{Binding BodyMoveStepSummary}" />

                    <UniformGrid Columns="2" Rows="3" IsEnabled="{Binding CanNudgeSelectedBody}">
                      <Button Classes="panel-button" Content="-X" Tag="0:-1" Click="OnBodyNudgeClicked" />
                      <Button Classes="panel-button" Content="+X" Tag="0:1" Click="OnBodyNudgeClicked" />
                      <Button Classes="panel-button" Content="-Y" Tag="1:-1" Click="OnBodyNudgeClicked" />
                      <Button Classes="panel-button" Content="+Y" Tag="1:1" Click="OnBodyNudgeClicked" />
                      <Button Classes="panel-button" Content="-Z" Tag="2:-1" Click="OnBodyNudgeClicked" />
                      <Button Classes="panel-button" Content="+Z" Tag="2:1" Click="OnBodyNudgeClicked" />
                    </UniformGrid>

                    <Button
                      Classes="panel-button"
                      IsEnabled="{Binding CanResetSelectedBodyPosition}"
                      Content="Reset Position"
                      Click="OnBodyResetClicked" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowProjectionPanel}" Spacing="8">
              <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="PROJECTION SKETCH" />
              <Border
                Padding="10"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                  <Button
                    IsVisible="{Binding ShowProjectionStartAction}"
                    IsEnabled="{Binding CanStartPlaneSelection}"
                    Classes="panel-button"
                    Content="Add Plane"
                    Click="OnAddPlaneClicked" />
                  <TextBlock
                    IsVisible="{Binding ShowProjectionStartAction}"
                    FontSize="10"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding ProjectionToolHint}" />

                  <StackPanel IsVisible="{Binding IsPlaneSelectionActive}" Spacing="8">
                    <TextBlock
                      FontSize="10"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      Text="DEFINE PLANE BY" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <Button
                        Grid.Column="0"
                        Classes="chip-button"
                        Classes.active="{Binding IsProjectionOriginMode}"
                        Content="Origin Planes"
                        Click="OnOriginPlaneModeClicked" />
                      <Button
                        Grid.Column="1"
                        Classes="chip-button"
                        Classes.active="{Binding IsProjectionFaceMode}"
                        Content="Shape Face"
                        Click="OnFacePlaneModeClicked" />
                    </Grid>

                    <TextBlock
                      FontSize="11"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      IsVisible="{Binding IsProjectionOriginMode}"
                      Text="Click an origin plane square in the viewport or choose XY, XZ, or YZ here." />
                    <TextBlock
                      FontSize="11"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      IsVisible="{Binding IsProjectionFaceMode}"
                      Text="Click a flat face of the 3D model in the viewport or use the current single-face selection." />

                    <StackPanel IsVisible="{Binding IsProjectionOriginMode}" Spacing="6">
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="ORIGIN PLANES" />
                      <UniformGrid Columns="3" Rows="1">
                        <Button
                          Classes="chip-button"
                          Classes.active="{Binding IsProjectionXYSelected}"
                          IsEnabled="{Binding CanSelectProjectionOriginPlane}"
                          Content="XY"
                          Click="OnProjectionXYClicked" />
                        <Button
                          Classes="chip-button"
                          Classes.active="{Binding IsProjectionXZSelected}"
                          IsEnabled="{Binding CanSelectProjectionOriginPlane}"
                          Content="XZ"
                          Click="OnProjectionXZClicked" />
                        <Button
                          Classes="chip-button"
                          Classes.active="{Binding IsProjectionYZSelected}"
                          IsEnabled="{Binding CanSelectProjectionOriginPlane}"
                          Content="YZ"
                          Click="OnProjectionYZClicked" />
                      </UniformGrid>
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding ProjectionOriginPlaneSummary}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsProjectionFaceMode}" Spacing="6">
                      <Button
                        Classes="panel-button"
                        IsEnabled="{Binding CanUseCurrentSelectionAsProjectionFace}"
                        Content="{Binding ProjectionFaceSelectionActionLabel}"
                        Click="OnUseSelectedFaceProjectionClicked" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding ProjectionFaceSelectionActionHint}" />
                    </StackPanel>

                    <TextBlock
                      FontSize="11"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      Text="{Binding ProjectionSelectionSummary}" />
                    <TextBlock
                      FontSize="10"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="{Binding ProjectionBodyScopeSummary}" />
                    <TextBlock
                      FontSize="10"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      IsVisible="{Binding IsProjectionFaceMode}"
                      Text="{Binding ProjectionFaceRequirementSummary}" />
                    <TextBlock
                      FontSize="10"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="{Binding ProjectionToolHint}" />

                    <StackPanel IsVisible="{Binding CanEditProjectionOffset}" Spacing="6">
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="OFFSET (MM)" />
                      <TextBox Text="{Binding PlaneOffsetText}" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding ProjectionOffsetHint}" />
                    </StackPanel>

                    <Button
                      IsVisible="{Binding CanEditProjectionOffset}"
                      IsEnabled="{Binding CanConfirmProjection}"
                      Classes="panel-button"
                      Content="Confirm Projection"
                      Click="OnConfirmProjectionClicked" />
                    <Button
                      Classes="panel-button"
                      Content="Cancel"
                      Click="OnCancelProjectionClicked" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowUnfoldPanel}" Spacing="8">
              <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="UNFOLD" />
              <Border
                Padding="10"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="8" RowSpacing="8">
                    <TextBlock
                      Grid.Row="0"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      FontSize="10"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      Text="Distort" />
                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding DistortionModeIndex}">
                      <ComboBoxItem Content="Conformal" />
                      <ComboBoxItem Content="Equal-Area" />
                      <ComboBoxItem Content="Equidistant" />
                      <ComboBoxItem Content="Balanced" />
                    </ComboBox>
                  </Grid>

                  <Border
                    Padding="8"
                    Background="#11000000"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="4">
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="NATIVE SEPARATE PIECES" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding UnfoldModeDescription}" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SeparateFlattenSelectionSummary}" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SeparateFlattenWholeBodySummary}" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding UnfoldEngineSummary}" />
                    </StackPanel>
                  </Border>

                  <Border
                    Padding="8"
                    Background="#11000000"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="4">
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="CURRENT CONFIGURATION" />
                      <TextBlock
                        FontSize="11"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding UnfoldConfigurationSummary}" />
                    </StackPanel>
                  </Border>

                  <CheckBox
                    IsEnabled="{Binding CanUseLiveRecompute}"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    IsChecked="{Binding LiveRecomputeEnabled}"
                    Content="Live Recompute" />

                  <StackPanel Spacing="6">
                    <TextBlock
                      FontSize="10"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      Text="PREVIEW SCOPE" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <Button
                        Grid.Column="0"
                        Classes="chip-button"
                        Classes.active="{Binding IsSelectedUnfoldPreviewScope}"
                        Content="Selected Faces"
                        Click="OnSelectedUnfoldPreviewScopeClicked" />
                      <Button
                        Grid.Column="1"
                        Classes="chip-button"
                        Classes.active="{Binding IsWholeBodyUnfoldPreviewScope}"
                        Content="Visible Bodies"
                        Click="OnWholeBodyUnfoldPreviewScopeClicked" />
                    </Grid>
                    <TextBlock
                      FontSize="10"
                      TextWrapping="Wrap"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      Text="{Binding UnfoldPreviewScopeSummary}" />
                  </StackPanel>

                  <TextBlock
                    FontSize="10"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding UnfoldPreviewModeSummary}" />

                  <Button
                    Classes="panel-button"
                    IsEnabled="{Binding CanRefreshActiveUnfoldPreview}"
                    Content="{Binding UnfoldPreviewRefreshButtonText}"
                    Click="OnRefreshUnfoldPreviewClicked" />

                  <Button
                    Classes="panel-button"
                    IsEnabled="{Binding CanUnfoldSelected}"
                    Content="{Binding UnfoldSelectedButtonText}"
                    Click="OnUnfoldSelectedClicked" />

                  <TextBlock
                    FontSize="10"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding UnfoldSelectedExecutionSummary}" />

                  <Button
                    Classes="panel-button"
                    IsEnabled="{Binding CanUnfoldEntireBody}"
                    Content="{Binding WholeBodyActionLabel}"
                    Click="OnUnfoldEntireBodyClicked" />

                  <TextBlock
                    FontSize="10"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding WholeBodyActionExecutionSummary}" />

                  <TextBlock
                    FontSize="10"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding UnfoldHintText}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowOutputPanel}" Spacing="8">
              <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="OUTPUT" />
              <Border
                Padding="10"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                  <TextBlock
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding OutputStatusSummary}" />
                  <TextBlock
                    FontSize="11"
                    IsVisible="{Binding HasGeneratedOutput}"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding GeneratedOutputFileName}" />
                  <TextBlock
                    FontSize="10"
                    IsVisible="{Binding HasGeneratedOutput}"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding GeneratedOutputFolder}" />

                  <Border
                    IsVisible="{Binding HasGeneratedOutputContext}"
                    Padding="8"
                    Background="#11000000"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="4">
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="GENERATED FROM" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding GeneratedOutputSourceSummary}" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding GeneratedOutputScopeSummary}" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding GeneratedOutputConfigurationSummary}" />
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding GeneratedOutputCreatedSummary}" />
                    </StackPanel>
                  </Border>

                  <Border
                    IsVisible="{Binding HasGeneratedOutputInspection}"
                    Padding="8"
                    Background="#11000000"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="4">
                      <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="INSPECTOR" />
                      <TextBlock
                        FontSize="10"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding GeneratedOutputFileHealthSummary}" />
                      <TextBlock
                        FontSize="10"
                        IsVisible="{Binding HasGeneratedOutputFileOnDisk}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding GeneratedOutputFileSizeSummary}" />
                      <TextBlock
                        FontSize="10"
                        IsVisible="{Binding HasGeneratedOutputFileOnDisk}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding GeneratedOutputLastModifiedSummary}" />
                      <TextBlock
                        FontSize="10"
                        IsVisible="{Binding HasGeneratedOutputFileOnDisk}"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding GeneratedOutputPreviewGeometrySummary}" />
                      <TextBlock
                        FontSize="10"
                        IsVisible="{Binding HasGeneratedOutputFileOnDisk}"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding GeneratedOutputEntityMixSummary}" />
                      <TextBlock
                        FontSize="10"
                        IsVisible="{Binding HasGeneratedOutputFileOnDisk}"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding GeneratedOutputUnsupportedEntitySummary}" />
                      <TextBlock
                        FontSize="10"
                        IsVisible="{Binding HasGeneratedOutputGeometry}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding GeneratedOutputBoundsSummary}" />
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                      Grid.Column="0"
                      Classes="panel-button"
                      IsEnabled="{Binding HasGeneratedOutputPreview}"
                      Content="{Binding OutputPreviewButtonLabel}"
                      Click="OnShowGeneratedOutputWorkspaceClicked" />
                    <Button
                      Grid.Column="1"
                      Classes="panel-button"
                      IsEnabled="{Binding HasGeneratedOutputFileOnDisk}"
                      Content="Open DXF"
                      Click="OnOpenGeneratedOutputClicked" />
                  </Grid>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                      Grid.Column="0"
                      Classes="panel-button"
                      IsEnabled="{Binding CanRefreshGeneratedOutput}"
                      Content="Refresh"
                      Click="OnRefreshGeneratedOutputClicked" />
                    <Button
                      Grid.Column="1"
                      Classes="panel-button"
                      IsEnabled="{Binding HasGeneratedOutputFileOnDisk}"
                      Content="Reveal File"
                      Click="OnRevealGeneratedOutputClicked" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="ERRORS" />
              <Border
                Padding="10"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock
                  FontSize="11"
                  TextWrapping="Wrap"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="{Binding ErrorMessage}" />
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
