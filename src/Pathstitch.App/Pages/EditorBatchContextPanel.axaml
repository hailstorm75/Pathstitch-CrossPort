<UserControl
  x:Class="Pathstitch.App.Pages.EditorBatchContextPanel"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:viewModels="using:Domain.App.ViewModels"
  x:DataType="viewModels:EditorBatchWorkspaceViewModel"
  AutomationProperties.AutomationId="editor.context.batch">
  <Border
    Background="{StaticResource PanelBackgroundBrush}"
    BorderBrush="{StaticResource BorderBrush}"
    BorderThickness="0,0,1,0"
    Padding="14">
    <StackPanel Spacing="12">
      <TextBlock
        FontSize="13"
        FontWeight="SemiBold"
        Foreground="{StaticResource SecondaryTextBrush}"
        Text="BATCH ACTIONS" />
      <TextBlock
        FontSize="10"
        TextWrapping="Wrap"
        Foreground="{StaticResource SecondaryTextBrush}"
        Text="Queue DXF files or projects here without opening them in the 2D or 3D editor." />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Select all" Click="OnSelectAllClicked" />
        <Button Content="Select none" Click="OnSelectNoneClicked" />
        <TextBlock VerticalAlignment="Center" Text="{Binding SelectedItemCount, StringFormat='Selected: {0}'}" />
      </StackPanel>
      <ComboBox
        AutomationProperties.AutomationId="editor.batch.action"
        ItemsSource="{Binding AvailableActions}"
        SelectedItem="{Binding SelectedAction}" />
      <TextBox
        AutomationProperties.AutomationId="editor.batch.input-path"
        PlaceholderText="Path to a .dxf or .stch file"
        Text="{Binding InputPath, Mode=TwoWay}" />
      <Button
        AutomationProperties.AutomationId="editor.batch.add"
        Classes="panel-button"
        Content="Add file"
        Click="OnAddProjectClicked" />
      <TextBox
        AutomationProperties.AutomationId="editor.batch.output-directory"
        PlaceholderText="Output directory (optional)"
        Text="{Binding OutputDirectory, Mode=TwoWay}" />
      <CheckBox
        AutomationProperties.AutomationId="editor.batch.export-selected-only"
        Content="Export selected only"
        IsChecked="{Binding ExportSelectedOnly, Mode=TwoWay}" />
      <TextBox
        x:Name="OffsetDistanceText"
        AutomationProperties.AutomationId="editor.batch.offset-distance"
        PlaceholderText="Offset distance"
        Text="1" />
      <ToggleSwitch
        AutomationProperties.AutomationId="editor.batch.continue-on-error"
        Content="Continue after errors"
        IsChecked="{Binding ContinueOnError}" />
      <Button
        AutomationProperties.AutomationId="editor.batch.run"
        Classes="panel-button"
        Content="Run batch"
        IsEnabled="{Binding CanRun}"
        Click="OnRunBatchClicked" />
      <Button
        AutomationProperties.AutomationId="editor.batch.export-dxf"
        Classes="panel-button"
        Content="Export DXF outputs"
        IsEnabled="{Binding CanExport}"
        Click="OnExportDxfClicked" />
      <Button
        AutomationProperties.AutomationId="editor.batch.apply-offset"
        Classes="panel-button"
        Content="Apply offset to DXFs"
        IsEnabled="{Binding CanOperateSelected}"
        Click="OnApplyOffsetClicked" />
      <TextBox
        x:Name="SewingDiameterText"
        AutomationProperties.AutomationId="editor.batch.sewing-diameter"
        PlaceholderText="Hole diameter"
        Text="1" />
      <TextBox
        x:Name="SewingPitchText"
        AutomationProperties.AutomationId="editor.batch.sewing-pitch"
        PlaceholderText="Hole pitch"
        Text="4" />
      <TextBox
        x:Name="SewingMarginText"
        AutomationProperties.AutomationId="editor.batch.sewing-margin"
        PlaceholderText="Hole margin"
        Text="2" />
      <Button
        AutomationProperties.AutomationId="editor.batch.apply-sewing-holes"
        Classes="panel-button"
        Content="Apply sewing holes to DXFs"
        IsEnabled="{Binding CanOperateSelected}"
        Click="OnApplySewingHolesClicked" />
    </StackPanel>
  </Border>
</UserControl>
