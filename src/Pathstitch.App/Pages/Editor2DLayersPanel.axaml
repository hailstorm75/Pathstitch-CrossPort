<UserControl
  x:Class="Pathstitch.App.Pages.Editor2DLayersPanel"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:Domain.App.Models"
  xmlns:viewModels="using:Domain.App.ViewModels"
  x:DataType="viewModels:EditorPageViewModel"
  AutomationProperties.AutomationId="editor.context.2d-layers">
  <Border
    Background="{StaticResource PanelBackgroundBrush}"
    BorderBrush="{StaticResource BorderBrush}"
    BorderThickness="0,0,1,0"
    Padding="14">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
      <DockPanel>
        <TextBlock
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{StaticResource SecondaryTextBrush}"
          Text="LAYERS" />
        <Button
          DockPanel.Dock="Right"
          AutomationProperties.AutomationId="editor.layers.add"
          Padding="8,2"
          Content="+"
          Click="OnCreateLayerClicked" />
        <Button
          DockPanel.Dock="Right"
          Margin="0,0,6,0"
          Padding="8,2"
          Content="+ Folder"
          Click="OnCreateFolderClicked" />
        <Button
          DockPanel.Dock="Right"
          Margin="0,0,6,0"
          Padding="8,2"
          Content="Merge selected"
          Click="OnMergeSelectedLayersClicked" />
        <Button
          DockPanel.Dock="Right"
          AutomationProperties.AutomationId="editor.layers.import-reference"
          Margin="0,0,6,0"
          Padding="8,2"
          Content="+ Image"
          Click="OnImportReferenceImageClicked" />
      </DockPanel>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding TwoDFolders}" Margin="0,12,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Editor2DLayerFolder">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
              <TextBlock VerticalAlignment="Center" Text="📁" />
              <TextBlock Width="150" VerticalAlignment="Center" Text="{Binding Name}" />
              <Button Padding="5,2" Content="Delete" Tag="{Binding Id}" Click="OnDeleteFolderClicked" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
        <ItemsControl ItemsSource="{Binding TwoDLayers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Editor2DLayer">
              <Border
                AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.layer.{0}}"
                Margin="0,0,0,8"
                Padding="8"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                  <Button
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Tag="{Binding Id}"
                    Click="OnSelectLayerClicked">
                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Name}" />
                  </Button>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="150" Text="{Binding Name, Mode=OneWay}" Tag="{Binding Id}" />
                    <Button Padding="5,2" Content="Rename" Tag="{Binding Id}" Click="OnRenameLayerClicked" />
                    <Button Padding="5,2" Content="Delete" Tag="{Binding Id}" Click="OnDeleteLayerClicked" />
                  </StackPanel>
                  <ComboBox
                    Tag="{Binding Id}"
                    PlaceholderText="Folder (root)"
                    ItemsSource="{Binding $parent[UserControl].DataContext.TwoDFolders}"
                    SelectedValue="{Binding ParentFolderId, Mode=OneWay}"
                    SelectedValueBinding="{Binding Id}"
                    SelectionChanged="OnLayerFolderChanged" />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock VerticalAlignment="Center" Text="Color" />
                    <TextBox Width="88" Text="{Binding ColorHex, Mode=OneWay}" Tag="{Binding Id}" />
                    <Button Padding="5,2" Content="Set" Tag="{Binding Id}" Click="OnSetLayerColorClicked" />
                  </StackPanel>
                  <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ContentSummary}" />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Padding="5,2" Content="Visible" Tag="{Binding Id}" Click="OnToggleVisibilityClicked" />
                    <Button Padding="5,2" Content="Lock" Tag="{Binding Id}" Click="OnToggleLockClicked" />
                    <Button Padding="5,2" Content="↑" Tag="{Binding Id}" Click="OnMoveLayerUpClicked" />
                    <Button Padding="5,2" Content="↓" Tag="{Binding Id}" Click="OnMoveLayerDownClicked" />
                    <Button Padding="5,2" Content="Merge ↓" Tag="{Binding Id}" Click="OnMergeLayerWithBelowClicked" />
                  </StackPanel>
                  <Button
                    Padding="5,2"
                    Content="Move selection here"
                    Tag="{Binding Id}"
                    Click="OnAssignSelectionClicked" />
                  <StackPanel IsVisible="{Binding IsReferenceImage}" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding !IsLocked}">
                      <TextBlock VerticalAlignment="Center" Text="Depth" />
                      <RadioButton
                        AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.depth.back.{0}}"
                        GroupName="{Binding Id}"
                        Padding="8,2"
                        Content="Back"
                        IsEnabled="{Binding !IsLocked}"
                        IsChecked="{Binding ReferenceImage.IsBack, Mode=OneWay}"
                        Tag="{Binding Id}"
                        Click="OnReferenceDepthBackClicked" />
                      <RadioButton
                        AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.depth.front.{0}}"
                        GroupName="{Binding Id}"
                        Padding="8,2"
                        Content="Front"
                        IsEnabled="{Binding !IsLocked}"
                        IsChecked="{Binding ReferenceImage.IsFront, Mode=OneWay}"
                        Tag="{Binding Id}"
                        Click="OnReferenceDepthFrontClicked" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Padding="5,2" Content="←" Tag="{Binding Id}" Click="OnReferenceMoveLeftClicked" />
                      <Button Padding="5,2" Content="→" Tag="{Binding Id}" Click="OnReferenceMoveRightClicked" />
                      <Button Padding="5,2" Content="↑" Tag="{Binding Id}" Click="OnReferenceMoveUpClicked" />
                      <Button Padding="5,2" Content="↓" Tag="{Binding Id}" Click="OnReferenceMoveDownClicked" />
                      <Button Padding="5,2" Content="−" Tag="{Binding Id}" Click="OnReferenceScaleDownClicked" />
                      <Button Padding="5,2" Content="+" Tag="{Binding Id}" Click="OnReferenceScaleUpClicked" />
                      <Button Padding="5,2" Content="↻" Tag="{Binding Id}" Click="OnReferenceRotateClicked" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Padding="5,2" Content="Fade" Tag="{Binding Id}" Click="OnReferenceFadeClicked" />
                      <Button Padding="5,2" Content="Brighten" Tag="{Binding Id}" Click="OnReferenceBrightenClicked" />
                      <Button Padding="5,2" Content="10%" Tag="{Binding Id}" Click="OnReferenceOpacity10Clicked" />
                      <Button Padding="5,2" Content="25%" Tag="{Binding Id}" Click="OnReferenceOpacity25Clicked" />
                      <Button Padding="5,2" Content="50%" Tag="{Binding Id}" Click="OnReferenceOpacity50Clicked" />
                      <Button Padding="5,2" Content="75%" Tag="{Binding Id}" Click="OnReferenceOpacity75Clicked" />
                      <Button Padding="5,2" Content="100%" Tag="{Binding Id}" Click="OnReferenceOpacity100Clicked" />
                      <Button Padding="5,2" Content="Trace −" Tag="{Binding Id}" Click="OnReferenceThresholdDownClicked" />
                      <Button Padding="5,2" Content="Trace +" Tag="{Binding Id}" Click="OnReferenceThresholdUpClicked" />
                    </StackPanel>
                    <Button
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.trace.{0}}"
                      Padding="5,2"
                      Content="Trace Image (Vectorize)"
                      Tag="{Binding Id}"
                      Click="OnTraceReferenceImageClicked" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button
                        IsVisible="{Binding !ReferenceImage.BackgroundRemoved}"
                        Padding="5,2"
                        Content="Remove Background"
                        Tag="{Binding Id}"
                        Click="OnRemoveReferenceBackgroundClicked" />
                      <Button
                        IsVisible="{Binding ReferenceImage.BackgroundRemoved}"
                        Padding="5,2"
                        Content="Restore Background"
                        Tag="{Binding Id}"
                        Click="OnRestoreReferenceBackgroundClicked" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="8">
        <Border
          IsVisible="{Binding HasTwoDReferenceTraceSession}"
          Padding="8"
          Background="{StaticResource InputBackgroundBrush}"
          BorderBrush="#22D3EE"
          BorderThickness="1"
          CornerRadius="6">
          <StackPanel Spacing="5">
            <TextBlock FontSize="11" FontWeight="SemiBold" Text="IMAGE TRACING" />
            <TextBlock FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Text="Preview contours draw in cyan." />
            <CheckBox Content="Silhouette only" IsChecked="{Binding TwoDReferenceTraceSilhouetteOnly, Mode=TwoWay}" />
            <TextBlock FontSize="10" Text="Threshold" />
            <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding TwoDReferenceTraceThreshold, Mode=TwoWay}" />
            <TextBlock FontSize="10" Text="Tolerance / detail" />
            <Slider Minimum="1" Maximum="100" TickFrequency="1" Value="{Binding TwoDReferenceTraceTolerance, Mode=TwoWay}" />
            <TextBlock FontSize="10" Text="Corner smoothness" />
            <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding TwoDReferenceTraceCornerSmoothness, Mode=TwoWay}" />
            <TextBlock FontSize="10" Text="Path optimization" />
            <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding TwoDReferenceTracePathOptimization, Mode=TwoWay}" />
            <TextBlock FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding TwoDReferenceTraceSummary}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Cancel" Click="OnCancelReferenceTraceClicked" />
              <Button
                AutomationProperties.AutomationId="editor.reference.trace.commit"
                Content="Generate Vectors"
                IsEnabled="{Binding CanCommitTwoDReferenceTrace}"
                Click="OnCommitReferenceTraceClicked" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding ShowTwoDReferenceCalibration}">
          <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="CALIBRATION WIDTH" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBox Width="90" Text="{Binding TwoDReferenceCalibrationWidthText, Mode=TwoWay}" />
            <Button Content="Calibrate" Click="OnCalibrateReferenceImageClicked" />
          </StackPanel>
          <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding TwoDReferencePointCalibrationSummary}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
              Content="Pick Two Points"
              IsEnabled="{Binding !TwoDActiveReferenceImageLocked}"
              Click="OnBeginReferencePointCalibrationClicked"
              AutomationProperties.AutomationId="editor.2d.reference-calibration.begin" />
            <Button Content="Cancel" Click="OnCancelReferencePointCalibrationClicked" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <TextBlock
        Grid.Row="4"
        Margin="0,8,0,0"
        FontSize="10"
        TextWrapping="Wrap"
        Foreground="{StaticResource SecondaryTextBrush}"
        Text="Selecting a layer selects all geometry assigned to it." />
    </Grid>
  </Border>
</UserControl>
