<UserControl
  x:Class="Pathstitch.App.Pages.Editor2DLayersPanel"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:help="using:Pathstitch.App.Help"
  xmlns:models="using:Domain.App.Models"
  xmlns:viewModels="using:Domain.App.ViewModels"
  xmlns:converters="using:Pathstitch.App.Converters"
  xmlns:colorPicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
  x:DataType="viewModels:EditorPageViewModel"
  AutomationProperties.AutomationId="editor.context.2d-layers">
  <UserControl.Resources>
    <converters:LayerColorHexToColorConverter x:Key="LayerColorConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.layer-icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.layer-icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.reference-position.invalid">
      <Setter Property="BorderBrush" Value="#EF4444" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>
  <Border
    Background="{StaticResource PanelBackgroundBrush}"
    BorderBrush="{StaticResource BorderBrush}"
    BorderThickness="1,1,0,0"
    Padding="12">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
        <TextBlock
          VerticalAlignment="Center"
          FontSize="15"
          Foreground="{StaticResource AccentBrush}"
          Text="▤" />
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{StaticResource SecondaryTextBrush}"
          Text="LAYERS" />
        <Button
          Grid.Column="2"
          Classes="layer-icon"
          AutomationProperties.AutomationId="editor.layers.import-reference"
          help:ContextualHelp.Text="Import a reference image as a color-coded image layer"
          ToolTip.Tip="Import reference image"
          Content="▧"
          Click="OnImportReferenceImageClicked" />
        <Button
          Grid.Column="3"
          Classes="layer-icon"
          help:ContextualHelp.Text="Merge the selected layers into one layer"
          ToolTip.Tip="Merge selected layers"
          Content="⇲"
          Click="OnMergeSelectedLayersClicked" />
        <Button
          Grid.Column="4"
          Classes="layer-icon"
          help:ContextualHelp.Text="Create a folder for organizing layers"
          ToolTip.Tip="Add folder"
          Content="▰"
          Click="OnCreateFolderClicked" />
        <Button
          Grid.Column="5"
          Classes="layer-icon"
          AutomationProperties.AutomationId="editor.layers.add"
          help:ContextualHelp.Text="Create a new drawing layer"
          ToolTip.Tip="Add layer"
          Content="+"
          Click="OnCreateLayerClicked" />
      </Grid>
      <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
        <ItemsControl ItemsSource="{Binding TwoDLayerHierarchyItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewModels:Editor2DLayerHierarchyItem">
              <Grid
                ColumnDefinitions="Auto,Auto,*"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="OnHierarchyDragOver"
                DragDrop.Drop="OnHierarchyDrop">
                <TextBlock
                  VerticalAlignment="Stretch"
                  FontFamily="Cascadia Mono,Menlo,Consolas"
                  FontSize="12"
                  Foreground="{StaticResource AccentBrush}"
                  Text="{Binding HierarchyGuide}" />
                <TextBlock
                  Grid.Column="1"
                  Width="14"
                  Margin="2,0,4,0"
                  VerticalAlignment="Center"
                  Cursor="SizeAll"
                  Text="⠿"
                  ToolTip.Tip="Drag to reorder or drop onto a folder"
                  PointerPressed="OnHierarchyDragStarted" />
                <StackPanel
                  Grid.Column="2"
                  IsVisible="{Binding IsFolder}"
                  Spacing="4"
                  Margin="0,0,0,4"
                  AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.folder.{0}}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                    <Button
                      Classes="layer-icon"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.folder.toggle.{0}}"
                      Content="{Binding ExpansionGlyph}"
                      ToolTip.Tip="Expand or collapse folder"
                      Tag="{Binding Id}"
                      Click="OnToggleFolderExpandedClicked" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource AccentBrush}" Text="▰" />
                    <TextBox Grid.Column="2" MinWidth="70" Text="{Binding Name, Mode=OneWay}" Tag="{Binding Id}" />
                    <Button Grid.Column="3" Classes="layer-icon" Content="✓" ToolTip.Tip="Rename folder" Tag="{Binding Id}" Click="OnRenameFolderClicked" />
                    <Button Grid.Column="4" Classes="layer-icon" Content="▰+" ToolTip.Tip="Add subfolder" Tag="{Binding Id}" Click="OnCreateSubfolderClicked" />
                    <Button Grid.Column="5" Classes="layer-icon" Content="×" ToolTip.Tip="Delete folder" Foreground="#EF4444" Tag="{Binding Id}" Click="OnDeleteFolderClicked" />
                  </Grid>
                </StackPanel>
                <ContentControl Grid.Column="2" IsVisible="{Binding IsLayer}" Content="{Binding Layer}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="models:Editor2DLayer">
                      <Border
                AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.layer.{0}}"
                Margin="0,0,0,8"
                Padding="8"
                Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="5">
                    <ToggleButton
                      Classes="layer-icon"
                      Content="{Binding VisibilityGlyph}"
                      ToolTip.Tip="{Binding VisibilityLabel}"
                      IsChecked="{Binding IsVisible, Mode=OneWay}"
                      Tag="{Binding Id}"
                      Click="OnToggleVisibilityClicked" />
                    <Button
                      Grid.Column="1"
                      Classes="layer-icon"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.layer.color.{0}}"
                      IsVisible="{Binding !IsReferenceImage}"
                      Tag="{Binding Id}"
                      ToolTip.Tip="Change layer color">
                      <Button.Flyout>
                        <Flyout Placement="Bottom">
                          <colorPicker:ColorPicker
                            Width="250"
                            Color="{Binding ColorHex, Converter={StaticResource LayerColorConverter}, Mode=OneWay}"
                            IsAlphaEnabled="False"
                            Tag="{Binding Id}"
                            ColorChanged="OnLayerColorChanged" />
                        </Flyout>
                      </Button.Flyout>
                      <Border
                        Width="16"
                        Height="16"
                        Background="{Binding ColorHex, Converter={StaticResource LayerColorConverter}}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3" />
                    </Button>
                    <TextBlock
                      Grid.Column="1"
                      Width="26"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="13"
                      Foreground="{StaticResource AccentBrush}"
                      IsVisible="{Binding IsReferenceImage}"
                      Text="▧" />
                    <Button
                      Grid.Column="2"
                      HorizontalContentAlignment="Left"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="5,2"
                      Tag="{Binding Id}"
                      Click="OnSelectLayerClicked">
                      <TextBlock Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    </Button>
                    <ToggleButton
                      Grid.Column="3"
                      Classes="layer-icon"
                      Content="{Binding LockGlyph}"
                      ToolTip.Tip="{Binding LockLabel}"
                      IsChecked="{Binding IsLocked, Mode=OneWay}"
                      Tag="{Binding Id}"
                      Click="OnToggleLockClicked" />
                    <Button
                      Grid.Column="4"
                      Classes="layer-icon"
                      Content="×"
                      ToolTip.Tip="Delete layer"
                      Foreground="#EF4444"
                      Tag="{Binding Id}"
                      Click="OnDeleteLayerClicked" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBox Text="{Binding Name, Mode=OneWay}" Tag="{Binding Id}" />
                    <Button
                      Grid.Column="1"
                      Classes="layer-icon"
                      Content="✓"
                      ToolTip.Tip="Rename layer"
                      Tag="{Binding Id}"
                      Click="OnRenameLayerClicked" />
                  </Grid>
                  <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button Classes="layer-icon" Content="⌂" ToolTip.Tip="Move layer to root" Tag="{Binding Id}" Click="OnMoveLayerToRootClicked" />
                    <Button Classes="layer-icon" Content="↑" ToolTip.Tip="Move layer up" Tag="{Binding Id}" Click="OnMoveLayerUpClicked" />
                    <Button Classes="layer-icon" Content="↓" ToolTip.Tip="Move layer down" Tag="{Binding Id}" Click="OnMoveLayerDownClicked" />
                    <Button Classes="layer-icon" Content="⇲" ToolTip.Tip="Merge with layer below" Tag="{Binding Id}" Click="OnMergeLayerWithBelowClicked" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ContentSummary}" />
                    <Button
                      Grid.Column="1"
                      Padding="7,2"
                      Content="⇤ Assign selection"
                      ToolTip.Tip="Move the current selection to this layer"
                      Tag="{Binding Id}"
                      Click="OnAssignSelectionClicked" />
                  </Grid>
                  <StackPanel IsVisible="{Binding IsReferenceImage}" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding !IsLocked}">
                      <TextBlock VerticalAlignment="Center" Text="Depth" />
                      <RadioButton
                        AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.depth.back.{0}}"
                        GroupName="{Binding Id}"
                        Padding="8,2"
                        Content="Back"
                        IsEnabled="{Binding !IsLocked}"
                        IsChecked="{Binding ReferenceImage.IsBack, Mode=OneWay}"
                        Tag="{Binding Id}"
                        Click="OnReferenceDepthBackClicked" />
                      <RadioButton
                        AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.depth.front.{0}}"
                        GroupName="{Binding Id}"
                        Padding="8,2"
                        Content="Front"
                        IsEnabled="{Binding !IsLocked}"
                        IsChecked="{Binding ReferenceImage.IsFront, Mode=OneWay}"
                        Tag="{Binding Id}"
                        Click="OnReferenceDepthFrontClicked" />
                    </StackPanel>
                    <StackPanel IsEnabled="{Binding !IsLocked}" Spacing="4">
                      <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="Position Offset (mm)" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock VerticalAlignment="Center" Text="X:" />
                        <TextBox
                          Classes="reference-position reference-position-x"
                          Width="72"
                          AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.position.x.{0}}"
                          Text="{Binding ReferenceImage.X, Mode=OneWay, StringFormat='{}{0:0.###}'}"
                          Tag="{Binding Id}"
                          KeyDown="OnReferencePositionTextKeyDown"
                          LostFocus="OnReferencePositionTextLostFocus" />
                        <TextBlock VerticalAlignment="Center" Text="Y:" />
                        <TextBox
                          Classes="reference-position reference-position-y"
                          Width="72"
                          AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.position.y.{0}}"
                          Text="{Binding ReferenceImage.Y, Mode=OneWay, StringFormat='{}{0:0.###}'}"
                          Tag="{Binding Id}"
                          KeyDown="OnReferencePositionTextKeyDown"
                          LostFocus="OnReferencePositionTextLostFocus" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding !IsLocked}">
                      <Button Padding="5,2" Content="←" Tag="{Binding Id}" PointerPressed="OnReferenceNudgePointerPressed" Click="OnReferenceMoveLeftClicked" />
                      <Button Padding="5,2" Content="↑" Tag="{Binding Id}" PointerPressed="OnReferenceNudgePointerPressed" Click="OnReferenceMoveUpClicked" />
                      <Button Padding="5,2" Content="↓" Tag="{Binding Id}" PointerPressed="OnReferenceNudgePointerPressed" Click="OnReferenceMoveDownClicked" />
                      <Button Padding="5,2" Content="→" Tag="{Binding Id}" PointerPressed="OnReferenceNudgePointerPressed" Click="OnReferenceMoveRightClicked" />
                      <Button Padding="5,2" Content="−" Tag="{Binding Id}" Click="OnReferenceScaleDownClicked" />
                      <Button Padding="5,2" Content="+" Tag="{Binding Id}" Click="OnReferenceScaleUpClicked" />
                      <Button Padding="5,2" Content="↻" Tag="{Binding Id}" Click="OnReferenceRotateClicked" />
                    </StackPanel>
                    <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="Nudge (Shift=10mm)" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsEnabled="{Binding !IsLocked}">
                      <TextBlock VerticalAlignment="Center" Text="Opacity" />
                      <Slider
                        x:Name="ReferenceOpacitySlider"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.opacity.{0}}"
                        Minimum="0"
                        Maximum="1"
                        SmallChange="0.01"
                        LargeChange="0.1"
                        Value="{Binding ReferenceImage.Opacity, Mode=OneWay}"
                        Tag="{Binding Id}"
                        LostFocus="OnReferenceOpacitySliderLostFocus"
                        PointerReleased="OnReferenceOpacitySliderPointerReleased"
                        ValueChanged="OnReferenceOpacitySliderValueChanged" />
                      <TextBlock
                        Grid.Column="2"
                        MinWidth="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding #ReferenceOpacitySlider.Value, StringFormat='{}{0:P0}'}" />
                    </Grid>
                    <WrapPanel>
                      <Button Padding="5,2" Content="Fade" Tag="{Binding Id}" Click="OnReferenceFadeClicked" />
                      <Button Padding="5,2" Content="Brighten" Tag="{Binding Id}" Click="OnReferenceBrightenClicked" />
                      <Button Padding="5,2" Content="10%" Tag="{Binding Id}" Click="OnReferenceOpacity10Clicked" />
                      <Button Padding="5,2" Content="25%" Tag="{Binding Id}" Click="OnReferenceOpacity25Clicked" />
                      <Button Padding="5,2" Content="50%" Tag="{Binding Id}" Click="OnReferenceOpacity50Clicked" />
                      <Button Padding="5,2" Content="75%" Tag="{Binding Id}" Click="OnReferenceOpacity75Clicked" />
                      <Button Padding="5,2" Content="100%" Tag="{Binding Id}" Click="OnReferenceOpacity100Clicked" />
                      <Button Padding="5,2" Content="Trace −" Tag="{Binding Id}" Click="OnReferenceThresholdDownClicked" />
                      <Button Padding="5,2" Content="Trace +" Tag="{Binding Id}" Click="OnReferenceThresholdUpClicked" />
                    </WrapPanel>
                    <Button
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=editor.reference.trace.{0}}"
                      Padding="5,2"
                      Content="Trace Image (Vectorize)"
                      Tag="{Binding Id}"
                      Click="OnTraceReferenceImageClicked" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button
                        IsVisible="{Binding !ReferenceImage.BackgroundRemoved}"
                        Padding="5,2"
                        Content="Remove Flat Background"
                        ToolTip.Tip="Deterministic flat or smooth-gradient cleanup; not AI subject cutout."
                        Tag="{Binding Id}"
                        Click="OnRemoveReferenceBackgroundClicked" />
                      <Button
                        IsVisible="{Binding ReferenceImage.BackgroundRemoved}"
                        Padding="5,2"
                        Content="Restore Background"
                        Tag="{Binding Id}"
                        Click="OnRestoreReferenceBackgroundClicked" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="8">
        <CheckBox
          AutomationProperties.AutomationId="editor.layers.auto-crop-reference-images"
          help:ContextualHelp.Text="Trim fully transparent borders from newly imported reference images"
          Content="Crop transparent margins on import"
          IsChecked="{Binding AutoCropTransparentReferenceImages, Mode=TwoWay}" />
        <Border
          IsVisible="{Binding HasTwoDReferenceTraceSession}"
          help:ContextualHelp.Text="{Binding TwoDReferenceTraceHelpText}"
          Padding="8"
          Background="{StaticResource InputBackgroundBrush}"
          BorderBrush="#22D3EE"
          BorderThickness="1"
          CornerRadius="6">
          <StackPanel Spacing="5">
            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding TwoDReferenceTraceTitle}" />
            <CheckBox Content="Silhouette only" IsChecked="{Binding TwoDReferenceTraceSilhouetteOnly, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="10" Text="Threshold" />
              <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Menlo,Consolas" FontSize="10" Text="{Binding TwoDReferenceTraceThreshold, StringFormat='{}{0:P0}'}" />
            </Grid>
            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" Value="{Binding TwoDReferenceTraceThreshold, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="10" Text="Tolerance / detail" />
              <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Menlo,Consolas" FontSize="10" Text="{Binding TwoDReferenceTraceTolerance, StringFormat='{}{0:0}'}" />
            </Grid>
            <Slider Minimum="1" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" Value="{Binding TwoDReferenceTraceTolerance, Mode=TwoWay}" />
            <TextBlock FontSize="8" Foreground="{StaticResource MutedTextBrush}" Text="Use Left/Right arrows to adjust by 1." />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="10" Text="Corner smoothness" />
              <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Menlo,Consolas" FontSize="10" Text="{Binding TwoDReferenceTraceCornerSmoothness, StringFormat='{}{0:0}'}" />
            </Grid>
            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" Value="{Binding TwoDReferenceTraceCornerSmoothness, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="10" Text="Path optimization" />
              <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Menlo,Consolas" FontSize="10" Text="{Binding TwoDReferenceTracePathOptimization, StringFormat='{}{0:0}'}" />
            </Grid>
            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" Value="{Binding TwoDReferenceTracePathOptimization, Mode=TwoWay}" />
            <TextBlock FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding TwoDReferenceTraceSummary}" />
            <ProgressBar
              AutomationProperties.AutomationId="editor.reference.trace.progress"
              IsIndeterminate="True"
              IsVisible="{Binding IsTwoDReferenceTraceRunning}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Cancel" Click="OnCancelReferenceTraceClicked" />
              <Button
                AutomationProperties.AutomationId="editor.reference.trace.commit"
                Content="{Binding TwoDReferenceTraceCommitLabel}"
                IsEnabled="{Binding CanCommitTwoDReferenceTrace}"
                Click="OnCommitReferenceTraceClicked" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Spacing="4" IsVisible="{Binding ShowTwoDReferenceCalibration}">
          <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="CALIBRATION WIDTH" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBox Width="90" Text="{Binding TwoDReferenceCalibrationWidthText, Mode=TwoWay}" />
            <Button Content="Calibrate" Click="OnCalibrateReferenceImageClicked" />
          </StackPanel>
          <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding TwoDReferencePointCalibrationSummary}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
              Content="Pick Two Points"
              IsEnabled="{Binding !TwoDActiveReferenceImageLocked}"
              Click="OnBeginReferencePointCalibrationClicked"
              AutomationProperties.AutomationId="editor.2d.reference-calibration.begin" />
            <Button Content="Cancel" Click="OnCancelReferencePointCalibrationClicked" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <TextBlock
        Grid.Row="3"
        Margin="0,8,0,0"
        FontSize="10"
        TextWrapping="Wrap"
        Foreground="{StaticResource SecondaryTextBrush}"
        Text="Selecting a layer selects all geometry assigned to it." />
    </Grid>
  </Border>
</UserControl>
