<UserControl
  x:Class="Pathstitch.App.Pages.EditorToolRail"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:Domain.App.Models"
  xmlns:viewModels="using:Domain.App.ViewModels"
  x:DataType="viewModels:EditorPageViewModel"
  AutomationProperties.AutomationId="editor.tool-rail">
  <Border
    Grid.Column="0"
    Background="{StaticResource PanelBackgroundBrush}"
    BorderBrush="{StaticResource BorderBrush}"
    BorderThickness="0,0,1,0"
    Padding="0">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer
        Grid.Row="0"
        Padding="10,16"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <ItemsControl
        HorizontalAlignment="Stretch"
        ItemsSource="{Binding SidebarTools}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel
              HorizontalAlignment="Center"
              Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:EditorSidebarToolItemViewModel">
            <StackPanel Spacing="10">
              <Border
                Margin="0,4,0,0"
                Height="1"
                Background="{StaticResource BorderBrush}"
                IsVisible="{Binding StartsSection}" />
              <Button
                AutomationProperties.AutomationId="{Binding Identifier}"
                Width="36"
                Height="36"
                Classes="tool-button"
                Classes.active="{Binding IsActive}"
                IsEnabled="{Binding IsEnabled}"
                Tag="{Binding Key}"
                ToolTip.Tip="{Binding TooltipText}"
                Click="OnSidebarToolClicked">
                <Grid>
                <Path
                  Width="18"
                  Height="18"
                  Data="{Binding IconPathData}"
                  Fill="{Binding $parent[Button].Foreground}"
                  IsVisible="{Binding HasIconPathData}"
                  Stretch="Uniform" />
                <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="{Binding $parent[Button].Foreground}"
                  IsVisible="{Binding !HasIconPathData}"
                  Text="{Binding FallbackGlyph}" />
                </Grid>
              </Button>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
      <Border
        Grid.Row="1"
        Margin="10,8,10,16"
        Width="36"
        Padding="4,8"
        Background="{StaticResource InputBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        IsVisible="{Binding IsShowingBatchWorkspace}">
        <TextBlock
          HorizontalAlignment="Center"
          FontSize="9"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Foreground="{StaticResource SecondaryTextBrush}"
          Text="BATCH" />
      </Border>
    </Grid>
  </Border>
</UserControl>
