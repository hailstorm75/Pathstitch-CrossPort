<Window
  x:Class="Pathstitch.App.Dialogs.ProjectOpenDispositionDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Open Project"
  Width="500"
  Height="220"
  CanResize="False"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  AutomationProperties.AutomationId="dialog.project-open">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto">
    <TextBlock
      FontSize="18"
      FontWeight="SemiBold"
      Text="A project is already open" />
    <TextBlock
      x:Name="ProjectMessage"
      Grid.Row="1"
      Margin="0,12,0,20"
      TextWrapping="Wrap" />
    <StackPanel
      Grid.Row="2"
      HorizontalAlignment="Right"
      Orientation="Horizontal"
      Spacing="8">
      <Button
        AutomationProperties.AutomationId="dialog.project-open.cancel"
        Content="Cancel"
        Click="OnCancelClicked" />
      <Button
        AutomationProperties.AutomationId="dialog.project-open.new-window"
        Content="New Window"
        Click="OnNewWindowClicked" />
      <Button
        AutomationProperties.AutomationId="dialog.project-open.combine"
        Content="Combine"
        Click="OnCombineClicked" />
    </StackPanel>
  </Grid>
</Window>
