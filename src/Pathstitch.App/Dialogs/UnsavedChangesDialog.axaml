<Window
  x:Class="Pathstitch.App.Dialogs.UnsavedChangesDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Unsaved Changes"
  Width="480"
  Height="210"
  CanResize="False"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  AutomationProperties.AutomationId="dialog.unsaved-changes">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto">
    <TextBlock
      FontSize="18"
      FontWeight="SemiBold"
      Text="Save changes before closing?" />
    <TextBlock
      x:Name="DocumentMessage"
      Grid.Row="1"
      Margin="0,12,0,20"
      TextWrapping="Wrap" />
    <StackPanel
      Grid.Row="2"
      HorizontalAlignment="Right"
      Orientation="Horizontal"
      Spacing="8">
      <Button
        AutomationProperties.AutomationId="dialog.unsaved-changes.cancel"
        Content="Cancel"
        Click="OnCancelClicked" />
      <Button
        AutomationProperties.AutomationId="dialog.unsaved-changes.discard"
        Content="Don't Save"
        Click="OnDiscardClicked" />
      <Button
        AutomationProperties.AutomationId="dialog.unsaved-changes.save"
        Content="Save"
        Click="OnSaveClicked" />
    </StackPanel>
  </Grid>
</Window>
