<Window
  x:Class="Pathstitch.App.Dialogs.PsdImportModeDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Import Photoshop File"
  Width="540"
  Height="490"
  CanResize="False"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  AutomationProperties.AutomationId="dialog.psd-import">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Import Photoshop File" />
    <TextBlock
      x:Name="DescriptionText"
      Grid.Row="1"
      Margin="0,10,0,16"
      TextWrapping="Wrap" />
    <StackPanel Grid.Row="2" Spacing="8">
      <Button AutomationProperties.AutomationId="dialog.psd-import.layers" HorizontalContentAlignment="Stretch" Click="OnLoadAsIsClicked">
        <StackPanel Margin="8,5" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Load As Is"/><TextBlock TextWrapping="Wrap" Text="Keep raster layers as reference images and vector layers as editable paths."/></StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="dialog.psd-import.flatten" HorizontalContentAlignment="Stretch" Click="OnLoadAsOneClicked">
        <StackPanel Margin="8,5" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Load As One Image"/><TextBlock TextWrapping="Wrap" Text="Flatten every layer into one reference image."/></StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="dialog.psd-import.vectorize" HorizontalContentAlignment="Stretch" Click="OnAutoVectorizeClicked">
        <StackPanel Margin="8,5" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Auto-Convert to Vector"/><TextBlock TextWrapping="Wrap" Text="Keep layers separate and convert raster layers with the current trace defaults."/></StackPanel>
      </Button>
      <Button AutomationProperties.AutomationId="dialog.psd-import.merge-vectorize" HorizontalContentAlignment="Stretch" Click="OnMergeAndVectorizeClicked">
        <StackPanel Margin="8,5" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Merge &amp; Convert"/><TextBlock TextWrapping="Wrap" Text="Flatten everything to one image, then convert it to editable paths."/></StackPanel>
      </Button>
    </StackPanel>
    <Button Grid.Row="3" HorizontalAlignment="Right" AutomationProperties.AutomationId="dialog.psd-import.cancel" Content="Cancel" Click="OnCancelClicked" />
  </Grid>
</Window>
