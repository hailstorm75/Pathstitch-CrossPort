<Window
  x:Class="Pathstitch.App.Dialogs.EditorImportUnitsDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Check imported size"
  Width="520"
  Height="270"
  CanResize="False"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  AutomationProperties.AutomationId="dialog.import-units">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Check imported size" />
    <TextBlock
      x:Name="DescriptionText"
      Grid.Row="1"
      Margin="0,12,0,12"
      TextWrapping="Wrap" />
    <ComboBox
      x:Name="ScaleChoice"
      Grid.Row="2"
      VerticalAlignment="Top"
      AutomationProperties.AutomationId="dialog.import-units.choice" />
    <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button AutomationProperties.AutomationId="dialog.import-units.cancel" Content="Keep current" Click="OnCancelClicked" />
      <Button AutomationProperties.AutomationId="dialog.import-units.apply" Content="Apply" Click="OnApplyClicked" />
    </StackPanel>
  </Grid>
</Window>
